<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>盈亏日历</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 0; }
        #header { padding: 20px; background: #f8f8f8; text-align: center; }
        #stats { margin-top: 10px; }
        #progressBar { width: 80%; height: 20px; background: #ddd; margin: 10px auto; border-radius:10px; overflow:hidden; }
        #progress { height:100%; width:0; background: #4caf50; }
        #calendar { width:90%; max-width:800px; margin:20px auto; }
        .calendar-header { display:flex; justify-content:space-between; align-items:center; }
        .calendar-header button { padding:5px 10px; }
        .calendar-grid { display:grid; grid-template-columns: repeat(7,1fr); grid-gap:5px; margin-top:10px; }
        .day-name, .day { padding:10px; border:1px solid #ccc; text-align:right; position:relative; cursor:pointer; }
        .day.other { background:#f0f0f0; cursor:default; }
        .day[data-total] { }
        .day-positive { background:#e0f7e9; }
        .day-negative { background:#fdecea; }
        #modal { position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); display:flex; justify-content:center; align-items:center; }
        #modal.hidden { display:none; }
        #modalContent { background:#fff; padding:20px; border-radius:5px; width:90%; max-width:400px; max-height:90%; overflow:auto; }
        #modalContent label { display:block; margin:10px 0; }
        #modalContent input[type=number], #modalContent textarea { width:100%; }
        #imagePreview img { max-width:100%; max-height:100px; margin:5px; }
    </style>
</head>
<body>
    <div id="header">
        <h1>盈亏日历</h1>
        <div id="stats">
            累计盈亏: <span id="total">0</span> USD / 目标: <span id="target">50000</span> USD
            <div id="progressBar"><div id="progress"></div></div>
        </div>
    </div>
    <div id="calendar">
        <div class="calendar-header">
            <button id="prevBtn">&lt; 上月</button>
            <div><span id="monthYear"></span></div>
            <button id="nextBtn">下月 &gt;</button>
        </div>
        <div class="calendar-grid day-names">
            <div class="day-name">日</div><div class="day-name">一</div><div class="day-name">二</div>
            <div class="day-name">三</div><div class="day-name">四</div><div class="day-name">五</div>
            <div class="day-name">六</div>
        </div>
        <div class="calendar-grid days"></div>
    </div>
    <div id="modal" class="hidden">
        <div id="modalContent">
            <h2 id="modalDate"></h2>
            <label>合约: <input type="number" id="inputContract" value="0"></label>
            <label>打狗: <input type="number" id="inputDog" value="0"></label>
            <label>空投: <input type="number" id="inputAirdrop" value="0"></label>
            <label>复盘总结:<textarea id="inputSummary" rows="4"></textarea></label>
            <label>插入图片: <input type="file" id="inputImages" multiple accept="image/*"></label>
            <div id="imagePreview"></div>
            <button id="saveBtn">保存</button>
            <button id="closeBtn">关闭</button>
        </div>
    </div>
    <script>
        const target = 50000;
        let data = JSON.parse(localStorage.getItem('profitData') || '{}');
        let currentImages = [];
        let currentKey = '';
        let monthOffset = 0; // 从当前月开始偏移，0 表示当前月

        document.addEventListener('DOMContentLoaded', () => {
            renderStats();
            renderCalendar();
            document.getElementById('prevBtn').addEventListener('click', () => { monthOffset--; renderCalendar(); });
            document.getElementById('nextBtn').addEventListener('click', () => { monthOffset++; renderCalendar(); });
            document.getElementById('closeBtn').addEventListener('click', closeModal);
            document.getElementById('saveBtn').addEventListener('click', saveData);
            document.getElementById('inputImages').addEventListener('change', handleImages);
        });

        function renderStats() {
            const total = Object.values(data).reduce((sum, d) => sum + (d.contract||0) + (d.dog||0) + (d.airdrop||0), 0);
            document.getElementById('total').textContent = total.toFixed(2);
            const percent = Math.min(100, (total/target)*100);
            document.getElementById('progress').style.width = percent + '%';
        }

        function renderCalendar() {
            const now = new Date();
            let year = now.getFullYear();
            let month = now.getMonth() + monthOffset;
            while (month < 0) { month += 12; year--; }
            while (month > 11) { month -= 12; year++; }
            document.getElementById('monthYear').textContent = year + ' 年 ' + (month+1) + ' 月';
            const daysGrid = document.querySelector('#calendar .days');
            daysGrid.innerHTML = '';
            const firstDay = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month+1, 0).getDate();
            // 前空白
            for (let i=0;i<firstDay;i++){
                const cell = document.createElement('div');
                cell.classList.add('day','other');
                daysGrid.appendChild(cell);
            }
            for(let d=1; d<=daysInMonth; d++){
                const cell = document.createElement('div');
                cell.classList.add('day');
                const dateKey = `${year}-${String(month+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
                cell.textContent = d;
                if(data[dateKey]){
                    const totalDay = (data[dateKey].contract||0)+(data[dateKey].dog||0)+(data[dateKey].airdrop||0);
                    cell.dataset.total = totalDay;
                    cell.title = '当日盈亏: ' + totalDay.toFixed(2);
                    if(totalDay>0) cell.classList.add('day-positive');
                    if(totalDay<0) cell.classList.add('day-negative');
                }
                cell.addEventListener('click', () => openModal(dateKey));
                daysGrid.appendChild(cell);
            }
            renderStats();
        }

        function openModal(dateKey) {
            currentKey = dateKey;
            currentImages = data[dateKey]?.images || [];
            document.getElementById('modalDate').textContent = dateKey;
            document.getElementById('inputContract').value = data[dateKey]?.contract||0;
            document.getElementById('inputDog').value = data[dateKey]?.dog||0;
            document.getElementById('inputAirdrop').value = data[dateKey]?.airdrop||0;
            document.getElementById('inputSummary').value = data[dateKey]?.summary||'';
            renderImagePreview();
            document.getElementById('modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('modal').classList.add('hidden');
            document.getElementById('inputImages').value = '';
        }

